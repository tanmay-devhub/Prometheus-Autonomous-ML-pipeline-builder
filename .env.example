# Get free API keys:
# Gemini: https://aistudio.google.com
# E2B:    https://e2b.dev

GEMINI_API_KEY=your_gemini_api_key_here
E2B_API_KEY=your_e2b_api_key_here

# Ollama (runs locally — install from https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=llama3.1:8b
OLLAMA_CODE_MODEL=deepseek-coder:6.7b

# Gemini model (gemini-2.0-flash is free tier)
GEMINI_MODEL=gemini-2.0-flash

# Infrastructure (defaults work with docker-compose)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///prometheus.db

# Pipeline settings
MAX_RETRIES=3
E2B_TIMEOUT_SECONDS=300
